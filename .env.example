# ---------------------------------------------------------------------------
# Copy to `.env.local` for local overrides. Never commit real values.
# ---------------------------------------------------------------------------

# Canonical production origin (no trailing slash, no base path).
NEXT_PUBLIC_SITE_URL=https://gptthomu-cmd.github.io

# Path prefix the site is served from. Empty for local dev / custom domains.
# GitHub Pages project site: /testing-e-ortfoilo
NEXT_PUBLIC_BASE_PATH=

# ---------------------------------------------------------------------------
# Optional runtime overrides (defaults live in src/lib/site.ts)
# ---------------------------------------------------------------------------

# Google Analytics 4 Measurement ID. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (the `content` value).
# NEXT_PUBLIC_GSC_VERIFICATION=

# Consent Mode strategy for GA4: `prior` (no tag before consent) or `advanced`.
# NEXT_PUBLIC_GA_CONSENT_MODE=prior
